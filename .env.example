# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio — ya está en .gitignore.

# ─── Base de datos local ──────────────────────────────────────────────────────
DB_ENV=local
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=mi_spotify_tfg
DB_PORT=3306

# ─── Base de datos producción ─────────────────────────────────────────────────
DB_HOST_PROD=
DB_USER_PROD=
DB_PASS_PROD=
DB_NAME_PROD=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/mi-spotify/public/google-callback.php

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Administración ───────────────────────────────────────────────────────────
ADMIN_REGISTER_KEY=
